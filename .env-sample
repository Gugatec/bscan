# bscan — sample configuration
# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed.
# The first run of bscan.sh generates .env automatically via the setup wizard.

# Absolute path to your local clone of the bumblebee scanner tool
BUMBLEBEE_DIR="/path/to/bumblebee"

# Upstream repo to clone bumblebee from. Override with an SSH URL
# (git@github.com:perplexityai/bumblebee.git) if the repo is private.
BUMBLEBEE_REPO_URL="https://github.com/perplexityai/bumblebee"

# Root directory bumblebee will recursively scan
SCAN_ROOT="/Users"

# Output format: "human" (formatted dashboard) or "raw" (NDJSON passthrough)
OUTPUT_FORMAT="human"

# Automatically save a report file after each scan: "yes" or "no"
EXPORT_REPORT="yes"

# Directory where timestamped report files are written
LOG_DIR="$HOME/_scripts/LOGS"

# Delete report files older than this many days (integer)
RETENTION_DAYS="180"

# Check for bscan updates before each run and offer to pull when behind: "yes" or "no"
SYNC_BSCAN_REPO="yes"

# Pull the latest threat signatures from the bumblebee repo before each run: "yes" or "no"
SYNC_CATALOG="yes"
